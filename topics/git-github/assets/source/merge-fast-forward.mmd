flowchart TB
    subgraph panel1["Before"]
        direction LR
        p1A["A"]
        p1B["B (main)"]
        p1C["C"]
        p1D["D (docs/git-note)"]
        p1A --> p1B
        p1B --> p1C
        p1C --> p1D
    end
    subgraph panel2["After"]
        direction LR
        p2A["A"]
        p2B["B"]
        p2C["C"]
        p2D["D (main, docs/git-note)"]
        p2A --> p2B
        p2B --> p2C
        p2C --> p2D
    end

    classDef common fill:#64748b,stroke:#64748b,color:#ffffff
    classDef main fill:#2563eb,stroke:#2563eb,color:#ffffff
    classDef topic fill:#7c3aed,stroke:#7c3aed,color:#ffffff
    class p1A,p2A,p2B,p2C common
    class p1B,p2D main
    class p1C,p1D topic
